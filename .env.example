# TeleCommerce — environment variable reference
# Copy relevant sections into apps/web/.env.local and apps/api/.env
# (or apps/bot/.env). Never commit real secrets.

# ============================================================
# SUPABASE
# ============================================================
# Public project URL — not secret, safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL=https://hmsjerjguhxhwoubqdqm.supabase.co
# Publishable/anon key — safe to expose client-side (RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_publishable_key_from_supabase_dashboard
# Backend-only. NEVER expose to the client or commit this. Used by apps/api
# for privileged operations (e.g. admin actions) where RLS is intentionally
# bypassed under explicit authorization checks.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_backend_only

# Same values, without the NEXT_PUBLIC_ prefix, for apps/api:
SUPABASE_URL=https://hmsjerjguhxhwoubqdqm.supabase.co
SUPABASE_ANON_KEY=replace_with_publishable_key_from_supabase_dashboard

# ============================================================
# API
# ============================================================
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000

# ============================================================
# TELEGRAM BOT (Stage 8)
# ============================================================
TELEGRAM_BOT_TOKEN=replace_with_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret_for_webhook_verification

# ============================================================
# PAYMENTS (Stage 7)
# ============================================================
# Provider-specific keys go here once a provider is chosen. Use a sandbox/mock
# provider for local development per the master instructions (Stage 7).
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_SECRET_KEY=replace_with_sandbox_key
PAYMENT_WEBHOOK_SIGNING_SECRET=replace_with_webhook_signing_secret

# ============================================================
# EMAIL / NOTIFICATIONS (Stage 10)
# ============================================================
EMAIL_PROVIDER=none
EMAIL_PROVIDER_API_KEY=

# ============================================================
# VERCEL (set automatically in Vercel deployments; local defaults below)
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
